// Global UI config. Colors are (r, g, b, a) floats; the bubble fill is
// a gradient between the four corners. Defaults match the classic
// white box with black text.
//
// Display effects: the PSX dither pass and the CRT bleed/scanline/
// mask/vignette pass over the presented picture. Set `enabled: false`
// to turn one off; the strengths tune intensity (0 = invisible).
(
    dither: (enabled: true),
    crt: (
        enabled: true,
        bleed: 0.2,
        scanline: 0.35,
        mask: 0.25,
        vignette: 0.30,
    ),
    bubble: (
        top_left: (1.0, 0.0, 0.0, 1.0),
        top_right: (0.0, 1.0, 0.0, 1.0),
        bottom_right: (0.0, 0.0, 1.0, 1.0),
        bottom_left: (0.5, 0.5, 0.5, 1.0),
        text: (0.0, 0.0, 0.0, 1.0),
    ),
)
